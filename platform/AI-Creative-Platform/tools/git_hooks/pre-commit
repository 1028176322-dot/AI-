#!/usr/bin/env bash
# AI-Workspace pre-commit hook：任务强制层 + 权限边界（文件系统之外的第二道锁）
# 安装：git config core.hooksPath platform/AI-Creative-Platform/tools/git_hooks
#
# 强制链（对齐 task-enforcement.policy.yaml / project.yaml.task_system.enforcement_mode=strict）：
#   无 Task ID 不执行 / 无 Claim 不写入 / 无 Submission 不审查 / 无 Gate 不进正式目录
#
# 本钩子拦截两类旁路：
#   1) 提交路径越权：项目内容产物（NKB/approved/chapters/第一卷_道生/sources/outline）
#      未经任务系统（commit message 无 task_id= 且无非 tasks/ 工作区）被直接提交。
#   2) 权限边界：writer/reviewer/fixer 分支越权提交受保护目录。
#
# 豁免：platform/ 平台自身演进（由 system-maintainer 直接提交，元循环不自我发 task_id）；
#      operations/ Operation Manifest 本身；*.md 设计/治理文档（非内容产物）。
set -e

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
staged=$(git -c core.quotepath=false diff --cached --name-only)

reject() {
  echo "PRE-COMMIT REJECTED: $1"
  echo "当前分支: $branch"
  echo "（这是平台 AI 治理的 Git 约束；如需提交请经任务系统或调整暂存内容）"
  exit 1
}

# ── 1. 项目内容产物保护（无 Task 不执行）：受保护路径提交必须附带任务记录 ──
# 以"任务记录随本次提交"为硬证据（不读 commit message，避免误取上一个 commit）。
PROTECTED='^(projects/[^/]+/)?(NKB/|approved/|chapters/|第一卷_道生/|sources/|大纲_1000章总体规划\.md)'
if echo "$staged" | grep -Eq "$PROTECTED"; then
  if ! echo "$staged" | grep -qE "tasks/[^/]+/TASK-[A-Z0-9-]+\.yaml"; then
    reject "受保护内容路径（NKB/approved/chapters/第一卷_道生/sources）提交必须附带任务记录 tasks/<status>/TASK-xxx.yaml（无 Task 不得修改项目内容）"
  fi
fi

# ── 2. 分支权限边界（沿用既有规则）──
case "$branch" in
  ai/writer/*)
    echo "$staged" | grep -E '^(projects/[^/]+/)?(NKB/|approved/|core/|registry/|templates/)' \
      && reject "writer 分支不得提交 NKB/approved/core/registry/templates" || true
    ;;
  ai/reviewer/*)
    echo "$staged" | grep -E '^(projects/[^/]+/)?chapters/' \
      && reject "reviewer 分支不得提交 chapters/ 正文修改" || true
    ;;
  ai/fixer/*)
    echo "$staged" | grep -E '^(projects/[^/]+/)?(NKB/|approved/|core/|registry/|templates/)' \
      && reject "fixer 分支不得提交 NKB/approved/core/registry/templates" || true
    ;;
esac

# ── 3. NKB 变更必须附带 Operation Manifest（可追溯）──
if echo "$staged" | grep -qE '^(projects/[^/]+/)?NKB/'; then
  echo "$staged" | grep -qE '^(projects/[^/]+/)?operations/' \
    || reject "NKB 变更必须附带 operations/ 下的 Operation Manifest"
fi

exit 0
