# ---- generated cache (regenerated by `platform bootstrap`) ----
.cache/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/

# ---- OS / editor noise ----
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# ---- logs ----
*.log

# ---- local scratch / test scratch (never commit) ----
projects/_lc_tmp/

# ---- platform-derived runtime artifacts (regenerated by platform commands) ----
projects/*/runtime/
projects/*/analysis/
projects/*/audit/
# 例外：道法百年 audit/ 包含手写治理报告（非可重生日志），需入库
!projects/道法百年/audit/
projects/*/project/status.derived.yaml

# ---- platform-level runtime artifacts (regenerated by platform commands) ----
platform/AI-Creative-Platform/audit/
platform/AI-Creative-Platform/analysis/
platform/AI-Creative-Platform/runtime/caches/*
platform/AI-Creative-Platform/runtime/logs/*
platform/AI-Creative-Platform/runtime/reports/*
platform/AI-Creative-Platform/runtime/staging/*
!**/.gitkeep

# ---- task_engine 流转废弃标记（不入库） ----
**/*.obsolete

# ---- agent local auxiliary memory (not part of the repo) ----
.workbuddy/

# ---- SVN metadata (coexist with Git; keep SVN's .svn out of Git) ----
.svn/
