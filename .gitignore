# ---- generated cache (regenerated by `platform bootstrap`) ----
.cache/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/

# ---- OS / editor noise ----
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# ---- logs ----
*.log

# ---- local scratch / test scratch (never commit) ----
projects/_lc_tmp/

# ---- platform-derived runtime artifacts (regenerated by platform commands) ----
projects/*/runtime/
projects/*/analysis/
projects/*/audit/
